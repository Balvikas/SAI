    htmlOutput += "h1, h2 { font-size: 1.3rem; font-weight: 800; margin-bottom: 1.25rem; color: #ea580c; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 2px solid #fed7aa; padding-bottom: 0.5rem; }";
    htmlOutput += "table { width: 100%; border-collapse: collapse; white-space: nowrap; text-align: left; }";
    htmlOutput += "th { font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; padding: 0.75rem 1rem; border-bottom: 2px solid #e2e8f0; }";
    htmlOutput += "td { padding: 0.85rem 1rem; font-size: 0.95rem; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: middle; }";
    htmlOutput += ".group-section-header { background-color: #f1f5f9; color: #1e293b; font-weight: 800; font-size: 1rem; padding: 0.75rem 1rem; text-transform: uppercase; border-left: 4px solid #ea580c; }";
    htmlOutput += "tr:hover { background-color: #f8fafc; }";
    htmlOutput += ".badge-in { background-color: #d1fae5; color: #065f46; padding: 0.25rem 0.5rem; border-radius: 6px; font-weight: 600; }";
    htmlOutput += ".badge-out { background-color: #fee2e2; color: #991b1b; padding: 0.25rem 0.5rem; border-radius: 6px; font-weight: 600; }";
    htmlOutput += ".time-badge { background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; padding: 0.3rem 0.6rem; border-radius: 20px; font-weight: 700; font-size: 0.8rem; display: inline-block; }";
    htmlOutput += ".empty-state { text-align: center; color: #64748b; font-style: italic; padding: 2rem 0; font-size: 1.1rem; }";
    htmlOutput += "</style></head><body>";
    
    // CARD 1: PENDING CHECK-OUT
    htmlOutput += "<div class='card'><h1>🚪 Students Still Inside</h1>";
    if (sortedPendingGroups.length === 0) {
      htmlOutput += "<div class='empty-state'>🎉 All students have checked out safely today!</div>";
    } else {
      htmlOutput += "<table><thead><tr><th>Student Name</th><th>Parent / Guardian</th><th>Phone Number</th><th style='text-align:right;'>Checked In</th></tr></thead><tbody>";
      for (var m = 0; m < sortedPendingGroups.length; m++) {
        var groupName = sortedPendingGroups[m];
        var pendingStudents = groupedPending[groupName];
        var displayLabel = groupName.toLowerCase().indexOf("group") === -1 && groupName !== "No Group" ? "Group " + groupName : groupName;
        
        htmlOutput += "<tr><td colspan='4' class='group-section-header'>📂 " + displayLabel + " (" + pendingStudents.length + " Inside)</td></tr>";
        
        for (var s1 = 0; s1 < pendingStudents.length; s1++) {
          var pStudent = pendingStudents[s1];
          htmlOutput += "<tr><td style='font-weight:600;'>📍 " + pStudent.name + "</td><td>" + pStudent.parent + "</td><td>📞 " + pStudent.phone + "</td><td style='text-align:right;'><span class='time-badge'>In: " + pStudent.timestamp + "</span></td></tr>";
        }
      }
      htmlOutput += "</tbody></table>";
    }
    htmlOutput += "</div>";

    // CARD 2: PAIRED DAILY HISTORY LOG
    htmlOutput += "<div class='card'><h2>🕒 Today's Activity Log History</h2>";
    if (sortedHistoryGroups.length === 0) {
      htmlOutput += "<div class='empty-state'>No attendance entries logged yet today.</div>";
    } else {
      htmlOutput += "<table><thead><tr><th>Student Name</th><th style='text-align:right;'>Timeline Log (Side-by-Side)</th></tr></thead><tbody>";
      for (var n = 0; n < sortedHistoryGroups.length; n++) {
        var historyGroupName = sortedHistoryGroups[n];
        var historyStudents = groupedHistory[historyGroupName];
        var displayHistoryLabel = historyGroupName.toLowerCase().indexOf("group") === -1 && historyGroupName !== "No Group" ? "Group " + historyGroupName : historyGroupName;
        
        htmlOutput += "<tr><td colspan='2' class='group-section-header'>📂 " + displayHistoryLabel + " (" + historyStudents.length + " Logged Today)</td></tr>";
        
        for (var s2 = 0; s2 < historyStudents.length; s2++) {
          var hStudent = historyStudents[s2];
          htmlOutput += "<tr><td style='font-weight:600;'>📍 " + hStudent.name + "</td><td style='text-align:right;'><span class='badge-in'>🟢 In: " + hStudent.checkIn + "</span> &nbsp; <span class='badge-out'>🔴 Out: " + hStudent.checkOut + "</span></td></tr>";
        }
      }
      htmlOutput += "</tbody></table>";
    }
    htmlOutput += "</div></body></html>";
    
    return HtmlService.createHtmlOutput(htmlOutput).setTitle("Pending Check-Out Roster").setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  } catch(err) {
    return HtmlService.createHtmlOutput("❌ Error building timeline view: " + err.toString() + "");
  }
}


  // =================================================================
  // ORIGINAL PATHWAY: YOUR EXACT UNCHANGED ABSENTEE REPORT PAGE
  // =================================================================
  // =================================================================
  // ORIGINAL PATHWAY UPGRADED: BULLETPROOF HTML TABLE ABSENTEE REPORT
  // =================================================================
