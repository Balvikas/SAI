      if (sheet) {
        var lastRow = sheet.getLastRow();
        if (lastRow >= 2) {
          var rowsData = sheet.getRange(2, 1, lastRow - 1, 4).getValues();
          for (var i = 0; i < rowsData.length; i++) {
            if (rowsData[i][0].toString().toLowerCase().trim() === targetName) {
              var result = {
                grade: rowsData[i][1].toString(), 
                parent: rowsData[i][2].toString(),
                phone: rowsData[i][3].toString()
              };
              return ContentService.createTextOutput(JSON.stringify(result))
