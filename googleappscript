function doPost(e) {
  try {
    var rawText = e.postData.contents;
    var data = JSON.parse(rawText);
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    
    // =================================================================
    // PATHWAY A: STUDENT REGISTRATION MANAGEMENT (Insert/Update/Delete)
    // =================================================================
    if (data.action === "manageStudent") {
      var sheet = ss.getSheetByName("StudentList");
      if (!sheet) {
        return ContentService.createTextOutput(JSON.stringify({"status": "error", "message": "StudentList tab not found"}))
                             .setMimeType(ContentService.MimeType.JSON);
      }
      
      var lastRow = sheet.getLastRow();
      var targetName = data.fullName.toString().toLowerCase().trim();
      var nameFoundRow = -1;
      
      // Look up if student name already exists in column A
      if (lastRow >= 2) {
        var namesRange = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
        for (var i = 0; i < namesRange.length; i++) {
          if (namesRange[i].toString().toLowerCase().trim() === targetName) {
            nameFoundRow = i + 2; // Offset by 2 due to 0-indexing + header row
            break;
          }
        }
      }
      
      // Method A: INSERT
      if (data.method === "INSERT") {
        sheet.appendRow([data.fullName, data.grade, data.parent, data.phone.toString()]);
        return ContentService.createTextOutput(JSON.stringify({"status": "success", "info": "Inserted"}))
                             .setMimeType(ContentService.MimeType.JSON);
                             
      // Method B: UPDATE
      } else if (data.method === "UPDATE") {
        if (nameFoundRow === -1) {
          return ContentService.createTextOutput(JSON.stringify({"status": "error", "message": "Student profile not found to update"}))
                               .setMimeType(ContentService.MimeType.JSON);
        }
        if (data.grade)  sheet.getRange(nameFoundRow, 2).setValue(data.grade);
        if (data.parent) sheet.getRange(nameFoundRow, 3).setValue(data.parent);
        if (data.phone)  sheet.getRange(nameFoundRow, 4).setValue(data.phone.toString());
        return ContentService.createTextOutput(JSON.stringify({"status": "success", "info": "Updated"}))
                             .setMimeType(ContentService.MimeType.JSON);
                             
      // Method C: DELETE
      } else if (data.method === "DELETE") {
        if (nameFoundRow === -1) {
          return ContentService.createTextOutput(JSON.stringify({"status": "error", "message": "Student profile not found to delete"}))
                               .setMimeType(ContentService.MimeType.JSON);
        }
        sheet.deleteRow(nameFoundRow);
        return ContentService.createTextOutput(JSON.stringify({"status": "success", "info": "Deleted"}))
                             .setMimeType(ContentService.MimeType.JSON);
      }
    }
    
    // =================================================================
    // ORIGINAL PATHWAY: YOUR EXACT UNCHANGED ATTENDANCE KIOSK LOGS
    // =================================================================
    var logSheet = ss.getSheetByName("Sheet1") || ss.getSheets()[0]; 
    
    var studentName = data.student || data.studentName || ""; 
    var group = data.group || "";
    var parentName = data.parentName || "";
    var incomingPhone = data.parentPhone || "";
    var finalStatus = data.status || ""; 
    var pincode = data.pincode || data.Pincode || "";
    // Update your log sheet appendRow inside doPost(e) to capture the Volunteer Name:
    var authorizedBy = data.voter || data.volunteerName || "Self Kiosk";

    // Append columns cleanly straight into your tracker sheets logs layout grid rows
  logSheet.appendRow([
      new Date(),
      studentName,
      group,
      parentName,
      incomingPhone, 
      finalStatus, 
      pincode.toString(),
      authorizedBy // 👈 Appends the Volunteer's Name cleanly as an extra column cell!
    ]);
    return ContentService.createTextOutput(JSON.stringify({"status": "success"}))
                         .setMimeType(ContentService.MimeType.JSON);

  } catch(error) {
    return ContentService.createTextOutput(JSON.stringify({"status": "error", "message": error.toString()}))
                         .setMimeType(ContentService.MimeType.JSON);
  }
}
function doGet(e) {
