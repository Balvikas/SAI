          // Read all 5 columns: A (0), B (1), C (2), D (3), E (4)
          var values = sheet.getRange(2, 1, lastRow - 1, 5).getValues();
          for (var i = 0; i < values.length; i++) {
            var rowName = values[i][0].toString().trim();
            if (rowName !== "") { 
              // Store all corresponding details mapped under the student's name
              cacheData[rowName] = {
                // ✅ FIXED: Explicitly pulls Column E (Index 4) to map into the kiosk's group field!
                grade: values[i][4] ? values[i][4].toString().trim() : "--",
                parent: values[i][2] ? values[i][2].toString().trim() : "--",
                phone: values[i][3] ? values[i][3].toString().trim() : "--"
              };
            }
          }
        }
      }
      // Return the complete details dictionary object back to your kiosk
      return ContentService.createTextOutput(JSON.stringify(cacheData))
                           .setMimeType(ContentService.MimeType.JSON);
    } catch(err) {
      return ContentService.createTextOutput(JSON.stringify({"Error": err.toString()}))
                           .setMimeType(ContentService.MimeType.JSON);
    }
  }


  // =================================================================
  // ROUTE 2: FETCH INDIVIDUAL STUDENT DETAILS (Autofills Fields)
  // =================================================================
  if (action === "getStudentDetails") {
    try {
      var sheet = ss.getSheetByName("StudentList");
