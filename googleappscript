                           .setMimeType(ContentService.MimeType.JSON);
    } catch(err) {
      return ContentService.createTextOutput(JSON.stringify({"error": err.toString()}))
                           .setMimeType(ContentService.MimeType.JSON);
    }
  }
  
    // =================================================================
  // ROUTER 3: FIXED - COMBINED SAME-ROW CHECK-IN & CHECK-OUT HISTORY
  // =================================================================
 if (action === "getPendingCheckOut") {
  try {
    var logSheet = ss.getSheetByName("Sheet1") || ss.getSheets()[0]; 
    var lastRow = logSheet.getLastRow();
    
    var pendingRawMap = {}; 
    var historyRawMap = {}; 

    if (lastRow >= 2) {
      var logsData = logSheet.getRange(2, 1, lastRow - 1, 6).getValues();
      var todayStr = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "yyyy-MM-dd");
      
      for (var i = 0; i < logsData.length; i++) {
        var timestamp = logsData[i][0];
        var student = logsData[i][1] ? logsData[i][1].toString().trim() : "";
        var group = logsData[i][2] ? logsData[i][2].toString().trim() : "No Group"; // Pulling Group 0 - Group 4 values directly
        var parent = logsData[i][3] ? logsData[i][3].toString().trim() : "";
        var phone = logsData[i][4] ? logsData[i][4].toString().trim() : "";
        var currentStatus = logsData[i][5] ? logsData[i][5].toString().trim() : "";

        if (student !== "") {
          var logDateStr = Utilities.formatDate(new Date(timestamp), ss.getSpreadsheetTimeZone(), "yyyy-MM-dd");
          var formattedTime = Utilities.formatDate(new Date(timestamp), ss.getSpreadsheetTimeZone(), "h:mm a");

          if (logDateStr === todayStr) {
            if (currentStatus === "Check-in") {
              pendingRawMap[student] = { timestamp: formattedTime, group: group, parent: parent, phone: phone, status: currentStatus };
            } else if (currentStatus === "Check-out") {
              pendingRawMap[student] = { status: currentStatus };
            }

            if (!historyRawMap[student]) {
              historyRawMap[student] = { name: student, group: group, checkIn: "--", checkOut: "--" };
            }
            if (currentStatus === "Check-in") historyRawMap[student].checkIn = formattedTime;
            if (currentStatus === "Check-out") historyRawMap[student].checkOut = formattedTime;
          }
        }
      }
    }

    // 1. Group records into structured buckets by their raw Group value
    var groupedPending = {};
    var groupedHistory = {};

    for (var pKey in pendingRawMap) {
      if (pendingRawMap[pKey].status === "Check-in") {
        var pGroup = pendingRawMap[pKey].group;
        if (!groupedPending[pGroup]) groupedPending[pGroup] = [];
        
        groupedPending[pGroup].push({
          name: pKey,
          timestamp: pendingRawMap[pKey].timestamp,
          parent: pendingRawMap[pKey].parent,
          phone: pendingRawMap[pKey].phone,
          status: pendingRawMap[pKey].status
        });
      }
    }

    for (var hKey in historyRawMap) {
      var hGroup = historyRawMap[hKey].group;
      if (!groupedHistory[hGroup]) groupedHistory[hGroup] = [];
      
      groupedHistory[hGroup].push(historyRawMap[hKey]);
    }

    // Native numeric parsing helper for strict group sorting (0 through 4)
    var getGroupNumericValue = function(groupStr) {
      if (!groupStr) return 999;
      var cleanStr = groupStr.toString().toLowerCase().replace("group", "").trim();
      var num = parseInt(cleanStr, 10);
      return isNaN(num) ? 999 : num;
    };

    // 2. Sort the parent Group sections sequentially (Group 0 -> Group 4)
    var sortedPendingGroups = Object.keys(groupedPending).sort(function(a, b) {
      var weightA = getGroupNumericValue(a);
      var weightB = getGroupNumericValue(b);
      if (weightA !== weightB) return weightA - weightB;
      return a.toLowerCase().localeCompare(b.toLowerCase(), undefined, { numeric: true });
    });
    
    var sortedHistoryGroups = Object.keys(groupedHistory).sort(function(a, b) {
      var weightA = getGroupNumericValue(a);
      var weightB = getGroupNumericValue(b);
      if (weightA !== weightB) return weightA - weightB;
      return a.toLowerCase().localeCompare(b.toLowerCase(), undefined, { numeric: true });
    });

    // 3. Sort students alphabetically by name within each group container
    for (var g1 = 0; g1 < sortedPendingGroups.length; g1++) {
      groupedPending[sortedPendingGroups[g1]].sort(function(a, b) { 
        return a.name.toLowerCase().trim().localeCompare(b.name.toLowerCase().trim(), undefined, { numeric: true }); 
      });
    }
    for (var g2 = 0; g2 < sortedHistoryGroups.length; g2++) {
      groupedHistory[sortedHistoryGroups[g2]].sort(function(a, b) { 
        return a.name.toLowerCase().trim().localeCompare(b.name.toLowerCase().trim(), undefined, { numeric: true }); 
      });
    }

    // 4. Generate the dashboard HTML structure
    var htmlOutput = "<html><head><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>Pending Check-Out Dashboard</title>";
    htmlOutput += "<style>";
    htmlOutput += "body { font-family: system-ui, -apple-system, sans-serif; background-color: #f8fafc; color: #1e293b; padding: 2rem 1rem; margin: 0; }";
