  }


    // =================================================================
  // ROUTER 5: FIXED HISTORICAL ABSENTEE AUDITOR WITH HTML TABLE OUTPUT
  // =================================================================
  if (action === "getAbsenteesByDate") {
    try {
      var targetDateStr = e.parameter.dateStr; // Expected format: "YYYY-MM-DD"
      if (!targetDateStr) {
        return HtmlService.createHtmlOutput("<h2>❌ Error: No date provided</h2>");
      }
      
      // Convert target date into "dd-MMM-yy" string (e.g., "30-Aug-26")
      var targetDateObj = new Date(targetDateStr + "T00:00:00");
      var targetFormatted = Utilities.formatDate(targetDateObj, ss.getSpreadsheetTimeZone(), "dd-MMM-yy");

      var logSheet = ss.getSheetByName("Sheet1") || ss.getSheets();
      var rosterSheet = ss.getSheetByName("StudentList");
      
      var presentStudentsMap = {};

      // 1. Scan active attendance logs to see who physically checked in on this day
      if (logSheet) {
        var logLastRow = logSheet.getLastRow();
        if (logLastRow >= 2) {
          var logRows = logSheet.getRange(2, 1, logLastRow - 1, 6).getValues(); 
          for (var i = 0; i < logRows.length; i++) {
            var logTimestamp = logRows[i][0];
            var logStudentName = logRows[i][1] ? logRows[i][1].toString().trim() : "";
            
            if (logTimestamp && logStudentName !== "") {
              var logFormattedDate = Utilities.formatDate(new Date(logTimestamp), ss.getSpreadsheetTimeZone(), "dd-MMM-yy");
              if (logFormattedDate === targetFormatted) {
                presentStudentsMap[logStudentName.toLowerCase()] = true;
              }
            }
          }
        }
      }

      var groupedAbsentees = {}; 

      // 2. Scan master roster (Fetching 5 columns total to safely read Column E)
      if (rosterSheet) {
        var rosterLastRow = rosterSheet.getLastRow();
        if (rosterLastRow >= 2) {
          // Changed column width parameter from 4 to 5 to reach Column E
          var rosterRows = rosterSheet.getRange(2, 1, rosterLastRow - 1, 5).getValues();
          for (var j = 0; j < rosterRows.length; j++) {
            var masterName = rosterRows[j][0] ? rosterRows[j][0].toString().trim() : "";
            var parentValue = rosterRows[j][2] ? rosterRows[j][2].toString().trim() : "--"; // Column C
            var phoneValue = rosterRows[j][3] ? rosterRows[j][3].toString().trim() : "--";  // Column D
            var groupValue = rosterRows[j][4] ? rosterRows[j][4].toString().trim() : "No Group"; // 📂 Target Column E directly
            
            if (masterName !== "") {
              if (!presentStudentsMap[masterName.toLowerCase()]) {
                if (!groupedAbsentees[groupValue]) {
                  groupedAbsentees[groupValue] = [];
                }
                
                groupedAbsentees[groupValue].push({
